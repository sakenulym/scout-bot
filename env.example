# Скопируй этот файл в .env и заполни значения
# Railway читает переменные прямо из интерфейса — .env только для локального запуска

# Токен бота от @BotFather
BOT_TOKEN=8504998975:AAGEMXPkl6KmbLgqJ4O4HZT6XS5m90wTEuk

# ID группового чата скаутов (отрицательное число, начинается с -100...)
# Узнать: добавь @userinfobot в группу и напиши /start
SCOUT_GROUP_ID=-1001234567890

# ID чата менеджеров (куда бот будет слать алерты)
# Можно использовать свой личный chat_id для теста
MANAGER_CHAT_ID=-100987654321

# Через сколько минут без отчёта слать алерт (по умолчанию 20)
REPORT_TIMEOUT_MINUTES=20

# Во сколько отправлять итоговый отчёт за день (час и минута)
DAY_END_HOUR=22
DAY_END_MINUTE=0

# Таймзона
TIMEZONE=Asia/Almaty
